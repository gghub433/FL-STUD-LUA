{
  "name": "fl-lua-desktop",
  "productName": "FL LUA",
  "version": "0.3.0",
  "private": true,
  "description": "FL LUA as a desktop application: the same app in its own window, no browser needed",
  "author": {
    "name": "FL LUA",
    "email": "gghub433@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "node prepare.mjs && electron .",
    "smoke": "node prepare.mjs && electron . --smoke",
    "smoke:built": "node smoke.mjs",
    "dist": "node prepare.mjs && electron-builder --publish never"
  },
  "build": {
    "appId": "app.fllua.desktop",
    "productName": "FL LUA",
    "copyright": "FL LUA",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app/**"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "fllua",
        "name": "FL LUA project",
        "description": "FL LUA project",
        "mimeType": "application/x-fllua",
        "role": "Editor"
      }
    ],
    "compression": "normal",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "FL-LUA-windows-x64.${ext}"
    },
    "nsis": {
      "artifactName": "FL-LUA-windows-x64-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "FL LUA",
      "uninstallDisplayName": "FL LUA",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "FL-LUA-windows-x64.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "FL-LUA-linux-x64.${ext}",
      "desktop": {
        "entry": {
          "Name": "FL LUA",
          "Comment": "Digital audio workstation",
          "StartupWMClass": "FL LUA"
        }
      },
      "maintainer": "FL LUA <gghub433@users.noreply.github.com>",
      "synopsis": "Digital audio workstation"
    },
    "deb": {
      "artifactName": "FL-LUA-linux-x64.${ext}",
      "packageName": "fl-lua",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ]
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "FL-LUA-macos-${arch}.${ext}",
      "identity": "-"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gghub433",
        "repo": "FL-STUD-LUA"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gghub433/FL-STUD-LUA.git"
  },
  "desktopName": "fl-lua.desktop",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://github.com/gghub433/FL-STUD-LUA"
}
